// En Prisma 7 el bloque datasource NO lleva url: la cadena de conexión vive en
// prisma.config.ts, que sólo lee el CLI. Eso es lo que hace imposible que la
// app se conecte como owner por error — no lee ese archivo.
datasource db {
  provider = "postgresql"
}

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  // Next.js no resuelve los imports con extensión explícita del generador
  // nuevo; vaciarlo los deja como imports normales.
  importFileExtension = ""
}

enum EstadoTenant {
  TRIAL
  ACTIVO
  SUSPENDIDO

  @@map("estado_tenant")
}

enum Modulo {
  ORDENES_DE_TRABAJO
  TURNOS
  GASTRONOMIA

  @@map("modulo")
}

enum RolUsuario {
  DUENO
  EMPLEADO

  @@map("rol_usuario")
}

/// Lo que un EMPLEADO puede hacer. Un DUENO no necesita ninguna fila: la
/// guarda le devuelve verdadero sin consultar la tabla, que es lo que
/// garantiza que un dueño no pueda quedarse afuera de su propio local.
enum Permiso {
  ARTICULOS_CREAR
  ARTICULOS_EDITAR
  COSTOS
  CATEGORIAS
  VENTAS_ANULAR
  ORDENES_ANULAR
  // Administrar los planes de pago del local: cuánto recarga cada forma de
  // pago. Aparte de ARTICULOS_EDITAR porque no es tocar un precio: es una
  // palanca de una fila que mueve el precio de TODO el catálogo.
  PLANES_PAGO
  // Encender y apagar el bot de WhatsApp, y editar la información que
  // responde. NO incluye conectar ni desconectar el número: eso implica
  // firmar con Facebook y le saca (o le pone) el bot al WhatsApp que el local
  // usa todos los días, así que es del dueño y no se delega —misma regla por
  // la que /usuarios entero no es delegable: se reparte lo que opera el
  // negocio, no lo que reparte poder.
  BOT

  // Borrar un artículo del todo, con su historial de stock. Aparte de
  // ARTICULOS_EDITAR —que ya cubre desactivar y reactivar— porque se delega
  // por lo que la acción MUEVE: desactivar mueve una columna y se deshace con
  // un click; borrar no se deshace y se lleva filas de dos tablas más. Es el
  // mismo escalón que separa VENTAS_ANULAR y ORDENES_ANULAR de la edición.
  ARTICULOS_BORRAR

  // Corregir cómo se pagó una venta ya cobrada. Aparte de VENTAS_ANULAR y no
  // plegado sobre él, por lo mismo que ARTICULOS_BORRAR está aparte de
  // ARTICULOS_EDITAR: se delega por lo que la acción MUEVE. Anular da de baja
  // la venta entera y devuelve el stock —todo el mundo ve que desapareció—;
  // corregir la deja en pie diciendo que la plata entró de otra forma, que es
  // más silencioso. Un dueño puede querer delegar uno y no el otro, en
  // cualquiera de las dos direcciones.
  VENTAS_EDITAR

  // Editar la tabla del plan canje: cuánto paga el local por cada usado, los
  // rangos de batería y la moneda. La calculadora NO lo pide —la consulta
  // cualquiera con sesión—: es justamente el reparto que el pedido describe,
  // "el vendedor la consulta sin poder cambiarla". Aparte de PLANES_PAGO y de
  // ARTICULOS_EDITAR porque mueve otra plata: no un precio de venta sino lo que
  // el local entrega a cambio de un equipo, y un dueño puede querer que su
  // encargado lo cotice sin que toque los recargos, o al revés.
  CANJE_VALORES

  // Cargar la cotización del dólar del local (`CotizacionDelDolar`). Verla la
  // ve cualquiera con sesión —es un dato del mostrador—; cargarla es fijar el
  // número con el que el cobro arranca cada pago que cruza monedas, así que se
  // delega aparte. No se pliega sobre PLANES_PAGO aunque los dos muevan el
  // precio de todo el catálogo: un dueño puede querer que el encargado de la
  // mañana actualice el dólar sin poder tocar los recargos, que se deciden una
  // vez y no todos los días.
  COTIZACION

  @@map("permiso")
}

enum TipoArticulo {
  PRODUCTO
  SERVICIO

  @@map("tipo_articulo")
}

// El "por qué" de cada movimiento. Es el punto de extensión que CLAUDE.md le
// promete a los módulos: órdenes de trabajo descontando repuestos, gastronomía
// descontando insumos por receta. Sumar un motivo es una migración aditiva.
enum MotivoMovimiento {
  VENTA
  ANULACION_VENTA
  AJUSTE
  INGRESO

  @@map("motivo_movimiento")
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA_DEBITO
  TARJETA_CREDITO

  @@map("medio_pago")
}

enum Moneda {
  ARS
  USD

  @@map("moneda")
}

/// Qué clase de plata entra o sale del cajón SIN una venta (spec
/// docs/superpowers/specs/2026-10-18-arqueo-de-caja-design.md, decisión 2).
/// Tres y no dos ("entra"/"sale") porque un retiro del dueño y un gasto no son
/// lo mismo para quien lee el cierre: los dos bajan el efectivo, pero sólo el
/// egreso es plata que el local gastó, y por eso sólo el egreso exige nota.
enum TipoMovimientoCaja {
  /// Plata que entra sin venta: el cambio que se trae del banco.
  INGRESO
  /// Plata que sale para un gasto: el delivery, la limpieza.
  EGRESO
  /// Plata que el dueño se lleva durante el día, sin ser gasto.
  RETIRO

  @@map("tipo_movimiento_caja")
}

/// De qué lado salió un mensaje del bot. ENTRANTE lo escribió el cliente del
/// local; SALIENTE lo escribió el bot. No hay un tercer valor para "lo escribió
/// el dueño a mano desde su celular": esos mensajes no pasan por nosotros —el
/// número está en coexistencia y la app de WhatsApp Business habla directo con
/// Meta—, así que registrar un valor que nunca se va a escribir sería mentir
/// sobre lo que esta tabla sabe.
enum DireccionMensaje {
  ENTRANTE
  SALIENTE

  @@map("direccion_mensaje")
}

/// Por qué un mensaje entrante no se contestó. NULL significa que sí se
/// contestó (o que la respuesta está en camino).
///
/// Existe para que la pantalla pueda decir "te escribieron 40 veces mientras el
/// bot estaba apagado", que es el dato con el que un dueño decide prenderlo o
/// subir el tope. Sin esta columna, un entrante sin respuesta al lado es
/// indistinguible de uno que falló, y el dueño no tiene forma de saber cuál de
/// las dos cosas le está pasando.
enum MotivoSinRespuesta {
  BOT_APAGADO
  TOPE_MENSUAL
  TOPE_CONVERSACION
  SIN_TEXTO
  SIN_MODELO
  // El bot está en modo prueba y quien escribió no es uno de los números de
  // prueba del local: un cliente real. Se guarda igual —guardar siempre, decidir
  // después—, y es lo que le permite a la pantalla decir cuántos clientes
  // escribieron mientras el dueño probaba.
  MODO_PRUEBA

  @@map("motivo_sin_respuesta")
}

// A quién le contesta el bot. Tres estados y no un switch más una lista: con
// una lista que restringe "si tiene números", quitar el último le soltaría el
// bot a todos los clientes sin un gesto que lo diga. Ver
// docs/superpowers/specs/2026-09-15-bot-modo-prueba-design.md.
enum ModoBot {
  APAGADO
  PRUEBA
  TODOS

  @@map("modo_bot")
}

enum EstadoOrden {
  RECIBIDO
  EN_DIAGNOSTICO
  PRESUPUESTADO
  // El cliente aceptó el presupuesto. Antes de este estado esa aceptación no
  // quedaba registrada en ningún lado (ver CLAUDE.md, decisiones abiertas del
  // modelo de datos) — cae acá, después de PRESUPUESTADO, porque es el punto
  // real del recorrido donde el cliente dice que sí.
  APROBADO
  EN_REPARACION
  LISTO
  ENTREGADO
  SIN_REPARACION
  RECHAZADO

  @@map("estado_orden")
}

// La raíz. No tiene tenant_id porque ES el tenant; su policy de RLS compara
// contra id.
model Tenant {
  id                 String       @id @default(uuid(7)) @db.Uuid
  subdominio         String       @unique
  nombre             String
  estado             EstadoTenant @default(TRIAL)
  // El correlativo de ventas es POR TENANT, así que no puede ser una secuencia
  // de Postgres —esas son globales—. Se incrementa dentro de la misma
  // transacción que crea la venta: eso serializa las ventas simultáneas de un
  // mismo local (irrelevante: no hay dos cajas cobrando en el mismo
  // milisegundo) y a cambio no hay huecos ni números repetidos, que es lo que
  // hace que "la venta 123" sirva para hablar por teléfono.
  proximoNumeroVenta Int          @default(1) @map("proximo_numero_venta")
  // El correlativo del SKU autogenerado, por tenant y con el mismo mecanismo
  // que `proximoNumeroVenta`: un UPDATE … RETURNING dentro de la transacción
  // del alta. Contar artículos daría el mismo A-0007 a dos altas simultáneas,
  // y con `desactivadoEn` en juego llegaría a repetir uno ya usado apenas
  // alguien dé de baja algo.
  proximoSkuArticulo Int          @default(1) @map("proximo_sku_articulo")
  // El tercer correlativo por tenant. Va SIN huecos, como el de ventas.
  proximoNumeroOrden Int          @default(1) @map("proximo_numero_orden")
  // SIN LECTOR desde el ciclo de la cotización del dólar (2026-10-18,
  // docs/superpowers/specs/2026-10-18-cotizacion-del-dolar-design.md). Iba a
  // ser "a cuánto está el dólar en este local, hoy", y nunca tuvo escritor: la
  // cotización del local vive ahora en `CotizacionDelDolar`, una fila por
  // carga, porque el pedido trae historial (quién y cuándo) y una columna que
  // se pisa no lo guarda. El `DROP` de las dos columnas es un deploy posterior
  // (expand/contract): anotado en docs/contexto/proximos-pasos.md. Hasta
  // entonces nada las lee ni las escribe — no revivirlas.
  cotizacionUsd      Decimal?     @map("cotizacion_usd") @db.Decimal(12, 2)
  // Ver el comentario de arriba: misma suerte, mismo DROP pendiente.
  cotizacionUsdEn    DateTime?    @map("cotizacion_usd_en") @db.Timestamptz(3)
  creadoEn           DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn      DateTime     @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  modulos            TenantModule[]
  users              User[]
  clientes           Cliente[]
  articulos          Articulo[]
  ventas             Venta[]
  ventaItems         VentaItem[]
  pagos              Pago[]
  movimientos        MovimientoStock[]
  sesiones           Session[]
  cuentas            Account[]
  verificaciones     Verification[]
  ordenes            OrdenDeTrabajo[]
  eventosOrden       EventoOrden[]
  cajas              Caja[]
  categorias         Categoria[]
  usuarioPermisos    UsuarioPermiso[]
  planesDePago       PlanDePago[]
  bot                BotDeWhatsapp?
  conversaciones     ConversacionBot[]
  mensajesBot        MensajeBot[]
  numerosDePruebaBot NumeroDePruebaBot[]
  unidades           UnidadDeArticulo[]
  edicionesDeVenta   EdicionDeVenta[]
  pagosArchivados    PagoArchivado[]
  rangosDeBateria    RangoDeBateria[]
  modelosDeCanje     ModeloDeCanje[]
  valoresDeCanje     ValorDeCanje[]
  configuracionCanje ConfiguracionDeCanje?
  cotizaciones       CotizacionDelDolar[]
  movimientosDeCaja  MovimientoDeCaja[]

  @@map("tenants")
}

// La activación de un módulo es una fila. Un tenant activa varios: el local de
// celulares es núcleo + órdenes de trabajo.
model TenantModule {
  tenantId   String   @map("tenant_id") @db.Uuid
  modulo     Modulo
  activadoEn DateTime @default(now()) @map("activado_en") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, modulo])
  @@map("tenant_modules")
}

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  nombre        String
  email         String
  rol           RolUsuario @default(EMPLEADO)
  // Better Auth la exige en su schema core (`emailVerified`, required). Queda
  // siempre en false y nadie la lee: requireEmailVerification va apagado porque
  // en este ciclo no hay proveedor de mail.
  emailVerified Boolean    @default(false) @map("email_verificado")
  // Idem: parte del core de Better Auth, sin uso todavía. El campo se llama
  // `image` (como Better Auth lo exige) y no `imagen`: la Task 2 sólo mapea
  // `name`, `createdAt` y `updatedAt` en su config, así que cualquier campo
  // del core sin ese nombre exacto necesitaría una entrada de mapeo propia
  // que puede desincronizarse en silencio — la misma razón por la que
  // emailVerified ya se llama así arriba. La columna de la base sigue en
  // español vía @map.
  image         String?    @map("imagen")
  // Dar de baja a un empleado NO puede ser borrar la fila: ventas.usuario_id es
  // una FK con onDelete: Restrict, así que la fila de quien vendió algo alguna
  // vez es indestructible por diseño. Se desactiva.
  desactivadoEn DateTime?  @map("desactivado_en") @db.Timestamptz(3)
  creadoEn      DateTime   @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime   @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ventasHechas         Venta[]              @relation("VentasHechas")
  ventasAnuladas       Venta[]              @relation("VentasAnuladas")
  movimientos          MovimientoStock[]
  sesiones             Session[]
  cuentas              Account[]
  ordenesRecibidas     OrdenDeTrabajo[]     @relation("OrdenesRecibidas")
  ordenesAnuladas      OrdenDeTrabajo[]     @relation("OrdenesAnuladas")
  eventosOrden         EventoOrden[]
  cajasAbiertas        Caja[]               @relation("CajasAbiertas")
  cajasCerradas        Caja[]               @relation("CajasCerradas")
  permisos             UsuarioPermiso[]
  unidadesIngresadas   UnidadDeArticulo[]   @relation("UnidadesIngresadas")
  unidadesDadasDeBaja  UnidadDeArticulo[]   @relation("UnidadesDadasDeBaja")
  ventasEditadas       EdicionDeVenta[]     @relation("VentasEditadas")
  cotizacionesCargadas CotizacionDelDolar[]
  movimientosDeCaja    MovimientoDeCaja[]

  // Por tenant y no global: la misma persona puede trabajar en dos negocios.
  @@unique([tenantId, email])
  @@map("users")
}

/// Un permiso otorgado a una persona.
///
/// **La fila ES el permiso; su ausencia es la negación.** Sin columna booleana
/// y sin tri-estado: revocar es un DELETE. Eso es lo que hace que la migración
/// no necesite ningún backfill — los usuarios que ya existen quedan
/// exactamente como estaban, porque hoy no pueden nada de esto.
///
/// **Un empleado desactivado conserva sus filas** y vuelve con los mismos
/// permisos si lo reactivan. Es coherente con que la baja acá sea lógica
/// (`User.desactivadoEn`) y con lo que uno espera al readmitir a alguien.
/// Revocar es un acto aparte y explícito.
model UsuarioPermiso {
  tenantId   String   @map("tenant_id") @db.Uuid
  usuarioId  String   @map("usuario_id") @db.Uuid
  permiso    Permiso
  otorgadoEn DateTime @default(now()) @map("otorgado_en") @db.Timestamptz(3)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario User   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([tenantId, usuarioId, permiso])
  @@map("usuario_permisos")
}

/// Quien le compra al local, o le deja un equipo.
///
/// Nace donde se lo tiene enfrente: al cobrar (`/vender`) o al recibir un
/// equipo (`/servicio-tecnico/nuevo`). `/clientes` es el lugar para buscarlo,
/// corregirlo y exportarlo. Spec:
/// docs/superpowers/specs/2026-10-18-clientes-design.md.
model Cliente {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  nombre        String
  // Tal cual se tipeó: "11 2233-4455" se muestra así. La comparación de
  // repetidos usa `telefonoClave`, no esta columna.
  telefono      String?
  email         String?
  // Texto libre del local sobre el cliente ("prefiere que le escriban a la
  // tarde"). Nullable: ningún cliente cargado antes la tiene.
  notas         String?
  // El consentimiento para mandarle ofertas. Default FALSE a propósito: nadie
  // aceptó nada por haber sido cargado antes de que el campo existiera, y
  // escribirle a esa gente sin consentimiento es justo lo que el campo existe
  // para evitar. Lo marca quien carga al cliente, preguntándole.
  aceptaOfertas Boolean  @default(false) @map("acepta_ofertas")
  // Los últimos 10 dígitos del teléfono (`claveDeTelefono`,
  // lib/clientes/telefono.ts), o NULL con menos de 10. La escribe la
  // aplicación en cada alta y edición; la migración la rellenó para las filas
  // que ya existían. Es la clave de duplicados.
  telefonoClave String?  @map("telefono_clave")
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ventas  Venta[]
  ordenes OrdenDeTrabajo[]

  @@index([tenantId])
  // COMÚN y no `@@unique`, a propósito. Las órdenes de servicio técnico
  // llevan semanas creando clientes al vuelo sin ningún chequeo, así que en
  // producción puede haber dos filas con el mismo número: un índice único
  // haría fallar la migración en el deploy, y resolver esos duplicados exige
  // decidir cuál queda —una fusión con sus ventas y sus órdenes—, que es otro
  // ciclo. Los repetidos NUEVOS los frena la aplicación (`crearClienteEn` y
  // `editarCliente`, lib/clientes/administrar.ts), bajo un lock por
  // (tenant, clave). El índice está para que ese chequeo y la búsqueda por
  // teléfono no recorran la tabla.
  @@index([tenantId, telefonoClave])
  @@map("clientes")
}

model Articulo {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  sku           String
  nombre        String
  tipo          TipoArticulo
  // Texto libre y no una tabla: un catálogo de local no necesita una taxonomía
  // con integridad referencial, y una tabla obliga a un ABM que nadie pidió.
  // La maqueta muestra dos niveles ("Accesorios · Protección"); si el dueño los
  // quiere, los escribe en el campo. Nullable porque los artículos que ya
  // existen no la tienen y ninguno se rompe sin ella.
  categoria     String?
  // La FK al árbol de categorías. Convive con `categoria` (el texto de arriba)
  // a propósito y por un tiempo acotado: expand/contract. Mientras haya código
  // desplegado que lea el texto, el texto se sigue escribiendo — es lo que
  // hace que el rollback a la imagen anterior encuentre el dato. El drop de la
  // columna vieja es un deploy POSTERIOR al de la UI, no el siguiente.
  //
  // Apunta a una RAÍZ o a una HOJA, indistinto: "Cables" sin marca es válido,
  // y forzar que todo cuelgue de una hoja obligaría a inventar una marca falsa
  // ("Cables · Genérico") para cada rubro que no usa marcas.
  categoriaId   String?      @map("categoria_id") @db.Uuid
  // Decimal y nunca Float: un flotante binario no representa 0,10 y el error
  // se acumula en cada suma de una caja.
  precio        Decimal      @db.Decimal(12, 2)
  // En qué moneda está cargado `precio`. Con USD, `precio` NO son pesos: son
  // dólares, y la conversión se hace recién al vender, con la cotización que
  // se tipea en ese momento. El default cubre todo lo cargado antes de este
  // ciclo, que era pesos por no haber otra opción.
  moneda        Moneda       @default(ARS)
  // Si este artículo se maneja por unidad física identificada (IMEI en
  // celulares, número de serie en cualquier otro producto caro). Con `true`,
  // el stock ES la cantidad de unidades libres y vender exige elegir una.
  //
  // El switch es del ARTÍCULO y no hay excepciones por unidad: un artículo con
  // serie donde algunas unidades no tienen IMEI dejaría el stock con dos
  // verdades ("dice 5 y hay 3 cargados") sin ninguna respuesta buena a qué
  // significa el número.
  llevaSerie    Boolean      @default(false) @map("lleva_serie")
  // Decimal(12,3) y no entero, aunque un local de celulares venda unidades:
  // CLAUDE.md ya tiene previsto gastronomía descontando insumos por receta, y
  // medio kilo de harina no es un entero. Cambiar el tipo después toca todas
  // las filas de todos los tenants; ponerlo bien ahora no cuesta nada.
  //
  // Es un CACHÉ de la suma de sus movimientos, no la fuente de verdad. Se
  // actualiza con UPDATE relativo en la misma transacción que el movimiento, y
  // `test/ventas.test.ts` prueba que la suma cierra.
  stock         Decimal      @default(0) @db.Decimal(12, 3)
  // Un artículo que se DEJA DE VENDER no se borra: se desactiva, y su historial
  // y sus ventas quedan intactos. Mismo campo y mismo sentido que
  // User.desactivadoEn, que ya sienta el precedente.
  //
  // Borrar existe y es otro acto (ciclo del 2026-09-07): es para el artículo
  // cargado por error, que nunca vendió nada y no tiene historia que
  // preservar. La regla la sostiene la base —venta_items.articulo_id sigue
  // siendo Restrict—, no un chequeo de la aplicación.
  desactivadoEn DateTime?    @map("desactivado_en") @db.Timestamptz(3)
  creadoEn      DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime     @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict: una categoría con artículos colgando no se borra. SetNull los
  // dejaría sin clasificar sin que nadie se entere, que es la misma pérdida
  // silenciosa con otro nombre.
  categoriaArbol Categoria? @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  movimientos MovimientoStock[]
  ventaItems  VentaItem[]
  unidades    UnidadDeArticulo[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoriaId])
  @@map("articulos")
}

/// Una unidad física del catálogo, con identidad propia.
///
/// Un nivel abajo del artículo: `Articulo` modela el MODELO ("iPhone 13 128
/// GB") y esta tabla la unidad concreta que está en la vitrina. `imei` se llama
/// así porque es el nombre del caso que la trajo; en cualquier otro rubro caro
/// es el número de serie, y el modelo es el mismo.
///
/// **"Libre" es `ventaId IS NULL AND bajaEn IS NULL`.** Una unidad no se borra
/// nunca: sale por una de las dos puertas y queda como historia — mismo
/// criterio que `Articulo.desactivadoEn` y `Venta.anuladaEn`. Borrar la fila se
/// llevaría la respuesta a "¿este equipo salió de acá?", que es justo la
/// pregunta que llega con un reclamo de garantía meses después.
model UnidadDeArticulo {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  articuloId     String    @map("articulo_id") @db.Uuid
  /// NULL significa "acá hay un teléfono, todavía no sabemos cuál". No rompe el
  /// invariante: cada teléfono físico sigue siendo una fila y `stock` sigue
  /// siendo la cantidad de filas libres — lo único que puede faltar es el
  /// identificador.
  ///
  /// El índice único parcial NO necesita excluirlos: en Postgres los NULL no
  /// chocan entre sí en un índice único, así que treinta unidades sin
  /// identificar conviven mientras se sigue prohibiendo que haya dos libres con
  /// el mismo IMEI real. Es la misma propiedad de `NULL <> NULL` que en el
  /// árbol de categorías fue el problema; acá es exactamente lo que se quiere.
  imei           String?
  ingresadaEn    DateTime  @default(now()) @map("ingresada_en") @db.Timestamptz(3)
  ingresadaPorId String    @map("ingresada_por_id") @db.Uuid
  /// La venta que se la llevó. NULL mientras esté en la vitrina.
  ventaId        String?   @map("venta_id") @db.Uuid
  /// La otra puerta de salida: se robó, se rompió, fue a garantía, estaba mal
  /// cargada. Con su nota, que es lo único que después explica el faltante.
  bajaEn         DateTime? @map("baja_en") @db.Timestamptz(3)
  bajaNota       String?   @map("baja_nota")
  bajaPorId      String?   @map("baja_por_id") @db.Uuid
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Cascade desde el ciclo del borrado (2026-09-07), por lo mismo que
  // movimientos_stock: las unidades de un artículo que nunca se vendió se van
  // con él. Un artículo CON ventas no llega acá — venta_items lo frena antes.
  articulo     Articulo @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  ingresadaPor User     @relation("UnidadesIngresadas", fields: [ingresadaPorId], references: [id], onDelete: Restrict)
  bajaPor      User?    @relation("UnidadesDadasDeBaja", fields: [bajaPorId], references: [id], onDelete: Restrict)
  venta        Venta?   @relation(fields: [ventaId], references: [id], onDelete: Restrict)

  movimientos MovimientoStock[]

  // La unicidad REAL del IMEI no está acá: es un índice único PARCIAL —sólo
  // entre las libres— que Prisma no sabe expresar y que vive en el SQL de la
  // migración. Éstos son los de lectura: por artículo (la ficha lista sus
  // unidades libres) y por imei (el escaneo del mostrador).
  @@index([tenantId, articuloId])
  @@index([tenantId, imei])
  @@map("unidades_articulo")
}

// El árbol de categorías del local: dos niveles, el rubro arriba ("Celulares",
// "Fundas", "Cables") y la marca abajo. `padreId` NULL es una raíz.
//
// **Dos niveles y no un árbol libre.** La restricción NO está en el schema —
// nada acá impide colgar una hija de una hija—: vive en el servidor. En este
// ciclo es estructural, porque el único escritor (`asegurarCategoria`, en
// lib/inventario/categorias.ts) busca la raíz con padre NULL y cuelga de ella
// siempre; con el ABM va a ser una validación explícita, porque mover una raíz
// debajo de otra es lo primero que puede violarla.
//
// Se eligió sobre dos tablas separadas (`Categoria` y `Marca`, que garantizan
// los dos niveles por estructura) porque ésas duplican el ABM entero y
// convierten "mover Samsung de Celulares a Fundas" —un UPDATE de una columna—
// en un caso especial.
model Categoria {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  nombre        String
  padreId       String?  @map("padre_id") @db.Uuid
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict en las dos direcciones, igual que con los artículos: borrar
  // "Celulares" no puede llevarse puestas sus marcas.
  padre  Categoria?  @relation("Jerarquia", fields: [padreId], references: [id], onDelete: Restrict)
  hijas  Categoria[] @relation("Jerarquia")

  articulos Articulo[]

  // NO alcanza solo. En Postgres NULL <> NULL, así que dos RAÍCES homónimas lo
  // pasan sin chistar: la migración suma un índice único PARCIAL
  // (WHERE padre_id IS NULL) que Prisma no sabe expresar acá. Éste cubre las
  // hijas; aquél, las raíces.
  @@unique([tenantId, padreId, nombre])
  @@index([tenantId, padreId])
  @@map("categorias")
}

// Las formas de pago del local y cuánto recargan. `Articulo.precio` es el
// precio de LISTA y cada plan deriva el suyo: no hay un segundo precio guardado
// en ningún lado, que es lo que evita que los dos se desincronicen.
model PlanDePago {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  nombre            String
  // A qué medio aplica. Es lo que hace que elegir "Crédito" en la fila de pago
  // ofrezca sólo los planes de crédito, y lo que le permite al servidor
  // rechazar un plan de tarjeta en un pago en efectivo.
  medio             MedioPago
  // Dato propio y no derivable del nombre: el mostrador necesita decir "6
  // cuotas de $X", y nadie va a parsear "Crédito 6 cuotas" para saberlo.
  cuotas            Int       @default(1)
  // CON SIGNO: +40.000 recarga, -10.000 descuenta (el descuento por efectivo es
  // tan común acá como el recargo por cuotas, y merece el mismo mecanismo y no
  // otro). Tres decimales porque los costos financieros vienen así (13.75 %);
  // (6,3) topea en 999.999, que ya no es un recargo sino un error de tipeo.
  recargoPorcentaje Decimal   @map("recargo_porcentaje") @db.Decimal(6, 3)
  // El orden del mostrador, que decide el dueño. Sin esto se ordena por nombre
  // y "Crédito 12 cuotas" queda antes que "Crédito 3 cuotas".
  orden             Int       @default(0)
  // Baja lógica, como Articulo y User: un plan que ya cobró ventas es
  // indestructible por la FK Restrict de `pagos`, así que se desactiva.
  desactivadoEn     DateTime? @map("desactivado_en") @db.Timestamptz(3)
  creadoEn          DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn     DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pagos           Pago[]
  pagosArchivados PagoArchivado[]

  @@unique([tenantId, medio, nombre])
  @@index([tenantId, medio])
  @@map("planes_de_pago")
}

// ── Plan canje ──────────────────────────────────────────────────────────────
//
// La tabla que el dueño tiene en la cabeza —cuánto paga por un usado según el
// modelo y la batería— escrita en el sistema, y nada más: ninguna de estas
// cuatro tablas toca ventas, stock ni caja. La calculadora de /plan-canje las
// LEE y calcula; registrar el canje como venta es un ciclo aparte (spec
// 2026-10-18-plan-canje-design.md, "Fuera de alcance"), y por eso borrar o
// cambiar una fila no puede romper ninguna operación pasada: todavía no existe
// ninguna que la nombre.
//
// Es núcleo y no un módulo: el canje no es exclusivo de los celulares. Por eso
// el "modelo" es un texto que escribe el dueño y no una FK a Articulo —el
// usado que entra no está en el catálogo— y el estado es un rango de batería,
// que es lo único que el cliente pidió. Si aparece otro eje (capacidad,
// estado estético), el rango pasa a ser uno de varios.

// Un rango CERRADO de porcentajes enteros, 0 ≤ minimo ≤ maximo ≤ 100 (CHECK en
// la migración, como red debajo de la validación de lib/canje/administrar.ts).
//
// Sin solapamientos dentro de un tenant, y eso NO lo dice la base: hacerlo con
// una exclusion constraint pide `btree_gist`, una extensión que sólo instala el
// superusuario (mismo motivo por el que la búsqueda no usa `unaccent`, ver
// lib/ventas/buscar.ts). Lo valida la aplicación, en la misma transacción que
// escribe y bajo un lock por tenant.
//
// Los huecos SÍ se permiten: un local que no toma equipos con menos de 80 % no
// carga ese rango, y la calculadora dice "sin cotización".
//
// Sin columna `orden` (ajuste sobre el spec, ver su sección "Ajustes durante
// la implementación"): como no se solapan, el orden de mayor a menor batería es
// total y es el único que tiene sentido para una tabla de canje. Un orden
// editable aparte sólo podría contradecirlo.
model RangoDeBateria {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  minimo        Int
  maximo        Int
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  valores ValorDeCanje[]

  @@index([tenantId])
  @@map("rangos_de_bateria")
}

// Un modelo de equipo usado, tal como lo escribe el dueño ("iPhone 14", "iPhone
// 13 Pro"). Texto libre a propósito: ver el comentario de la sección.
//
// Único por tenant SIN distinguir mayúsculas —"iphone 14" e "iPhone 14" son el
// mismo equipo y dos filas harían que el vendedor elija entre dos precios—. Eso
// lo garantiza un índice único de EXPRESIÓN, (tenant_id, lower(nombre)), que
// vive en la migración porque Prisma no sabe declararlo acá: mismo caso que el
// índice parcial de `categorias`. La aplicación lo chequea antes, para poder
// decir el nombre que choca.
model ModeloDeCanje {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  nombre        String
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  valores ValorDeCanje[]

  @@index([tenantId])
  @@map("modelos_de_canje")
}

// Lo que el local paga por ese modelo en ese rango. Una celda vacía de la tabla
// es AUSENCIA de fila, no un cero: "no tomamos ese equipo en ese estado" y "lo
// tomamos gratis" son cosas distintas, y la calculadora dice "sin cotización"
// sólo para la primera.
//
// Cascade desde modelo y rango: borrar "iPhone 8" se lleva sus valores, que es
// lo que el dueño quiere decir. Nada más apunta acá, así que el cascade no
// puede llevarse nada que no sea de la tabla de canje.
//
// Sin moneda propia: la moneda es una sola para toda la tabla
// (`ConfiguracionDeCanje`). `valor ≥ 0` tiene CHECK en la migración.
model ValorDeCanje {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  modeloId      String   @map("modelo_id") @db.Uuid
  rangoId       String   @map("rango_id") @db.Uuid
  valor         Decimal  @db.Decimal(12, 2)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modelo ModeloDeCanje  @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  rango  RangoDeBateria @relation(fields: [rangoId], references: [id], onDelete: Cascade)

  @@unique([modeloId, rangoId])
  @@index([tenantId])
  @@index([rangoId])
  @@map("valores_de_canje")
}

// La moneda de TODA la tabla de canje. Una por tabla y no una por celda: una
// tabla con unas celdas en pesos y otras en dólares no la escribe ningún local,
// y una moneda por celda obliga a mirar dos cosas en cada número.
//
// Una fila por tenant, con el tenant como clave. Que la fila NO exista es lo
// normal —el tenant que nunca entró a la tabla— y se lee como el default, USD:
// el pedido que abrió el ciclo es de un local que vende iPhones en dólares.
//
// Cambiar la moneda NO convierte los valores, y la pantalla lo avisa antes de
// confirmar. Cuando la tabla nació no había cotización de la cual hacerlo;
// desde el ciclo de la cotización del dólar (2026-10-18) el local tiene una, y
// sigue sin usarse acá a propósito: la tabla es lo que el dueño escribió, y
// reescribir cada valor con el dólar del día lo dejaría atado a un número que
// mañana cambia.
model ConfiguracionDeCanje {
  tenantId      String   @id @map("tenant_id") @db.Uuid
  moneda        Moneda   @default(USD)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("configuraciones_de_canje")
}

// La cotización del dólar del LOCAL: a cuánto la toma este negocio hoy. Una
// fila por carga, y la vigente es la más reciente.
//
// **Append-only**, como `ediciones_venta`, y no por comentario:
// `scripts/setup-db-roles.sh` le revoca UPDATE y DELETE al rol de la app.
// Corregir un cero de más es cargar otra; el historial (quién, cuándo, cuánto)
// es la mitad del pedido, y un historial que se puede editar no contesta
// "¿quién puso el dólar a 14.500 el martes?".
//
// **No es `Pago.cotizacion`**: aquélla es a cuánto se cobró UN pago, histórica
// e inmutable; ésta es el precio de hoy, y sólo arranca el campo del cobro si
// es DE HOY en hora argentina (`esDeHoy`, lib/formato/fechas.ts). Una vieja se
// muestra con su fecha y no convierte nada sola — el motivo por el que el
// ciclo del 2026-08-29 había prohibido precargar sigue vigente, y es lo que
// esa regla atiende. Ver docs/superpowers/specs/2026-10-18-cotizacion-del-dolar-design.md.
//
// La vigente es la de `creadaEn` más reciente, con desempate por `id`
// (uuid(7), ordenable por tiempo): `creado_en` es la hora de inicio de la
// transacción, así que dos cargas del mismo milisegundo no tienen otro orden.
//
// `valor > 0` tiene CHECK en la migración. Restrict hacia el usuario por lo
// mismo que `ediciones_venta`: el que cargó un dólar se desactiva, no se borra.
model CotizacionDelDolar {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  valor        Decimal  @db.Decimal(12, 2)
  cargadaPorId String   @map("cargada_por_id") @db.Uuid
  creadaEn     DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cargadaPor User   @relation(fields: [cargadaPorId], references: [id], onDelete: Restrict)

  // Sirve a las dos lecturas: la vigente (la última) y el historial (las diez
  // últimas), las dos "del tenant, de la más nueva a la más vieja".
  @@index([tenantId, creadaEn])
  @@map("cotizaciones_del_dolar")
}

// Append-only: nada se edita ni se borra. Es lo que permite responder "por qué
// tengo 3 y no 5", que es la pregunta que un dueño hace cuando el inventario no
// le cierra.
model MovimientoStock {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  articuloId    String           @map("articulo_id") @db.Uuid
  // Con signo: negativo descuenta, positivo ingresa.
  delta         Decimal          @db.Decimal(12, 3)
  // El costo del momento, no el actual. Es la única puerta de una sola
  // dirección que tenía el modelo: si un artículo se compró a 100 y hoy vale
  // 180, la venta de marzo se midió contra 100, y sin esta columna no hay dato
  // del cual reconstruirlo — todo movimiento creado antes de que exista queda
  // sin costo para siempre.
  //
  // Nullable: sólo el ingreso de mercadería (y el stock inicial del alta) la
  // escribe, y también ahí es opcional. Queda null en las ventas, en las
  // anulaciones y en las correcciones por conteo. La leen el tile "Último
  // costo" de la ficha, la valuación del stock y `crearVenta`, que congela el
  // último costo en el ítem.
  //
  // En la moneda de `monedaCosto`, NO siempre en pesos (ciclo del costo en
  // dólares, 2026-10-18).
  costoUnitario Decimal?         @map("costo_unitario") @db.Decimal(12, 2)
  // En qué moneda se pagó `costoUnitario`. Es del EVENTO de recepción y no del
  // artículo: un artículo puede pasar de pesos a dólares mañana y los ingresos
  // viejos tienen que seguir diciendo en qué moneda se compraron — mismo
  // criterio que `VentaItem.moneda`.
  //
  // No nullable y con default ARS: toda fila anterior a la columna es pesos (el
  // costo era pesos por construcción), y el default la describe sin backfill.
  // En una fila sin costo no significa nada. Nunca se convierte: nadie suma un
  // costo en dólares con uno en pesos, porque el sistema no guarda una
  // cotización en la que confiar.
  monedaCosto   Moneda           @default(ARS) @map("moneda_costo")
  motivo        MotivoMovimiento
  // Null en AJUSTE e INGRESO, que no vienen de una venta.
  ventaId       String?          @map("venta_id") @db.Uuid
  // Cuál unidad movió este movimiento, cuando el artículo lleva serie. Es lo
  // que deja que el historial diga qué IMEI entró y cuál salió, en vez de un
  // `+1` anónimo.
  //
  // NO es la decisión abierta que CLAUDE.md tiene anotada sobre esta tabla:
  // aquélla es sobre el ORIGEN del movimiento (venta / orden / comanda), ésta
  // sobre su SUJETO. Ejes distintos.
  unidadId      String?          @map("unidad_id") @db.Uuid
  usuarioId     String           @map("usuario_id") @db.Uuid
  nota          String?
  creadoEn      DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Cascade desde el ciclo del borrado (2026-09-07): el historial de stock es
  // del artículo, así que se va con él. El guard de "no se borra lo que se
  // vendió" NO vive acá —vive en venta_items, que sigue siendo Restrict—, y
  // eso es a propósito: sólo puede llegar a esta cascada un artículo que nunca
  // vendió nada.
  articulo Articulo          @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  venta    Venta?            @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  // NoAction y no Restrict: cuando se borra un artículo con serie, sus
  // movimientos y sus unidades se van en la MISMA sentencia. RESTRICT se
  // evalúa inmediato, sin esperar al final, así que abortaría el borrado por
  // una fila que se está yendo igual; NO ACTION es diferible y lo tolera.
  //
  // Y no Cascade: fuera de ese camino ninguna unidad se borra nunca —darla de
  // baja es una columna—, así que Cascade describiría un flujo que no existe.
  unidad   UnidadDeArticulo? @relation(fields: [unidadId], references: [id], onDelete: NoAction)
  usuario  User              @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([tenantId, articuloId])
  @@index([tenantId, ventaId])
  @@map("movimientos_stock")
}

model Venta {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  numero            Int
  // La clave que hace idempotente al cobro. La genera el punto de venta una vez
  // por venta y la manda escondida; si el mismo submit llega dos veces —doble
  // click, F5 sobre el POST, reintento de red— la segunda choca contra el
  // índice único de abajo y `crearVenta` devuelve la venta que ya existe en vez
  // de crear otra y descontar el stock dos veces.
  //
  // Nullable porque en Postgres un índice único deja pasar varios NULL: un
  // llamador que no la necesita —un test, un script— no tiene que inventarse
  // una.
  claveIdempotencia String?   @map("clave_idempotencia")
  // Opcional: la venta de mostrador, sin cliente identificado, es la mayoría de
  // las ventas de un local.
  clienteId         String?   @map("cliente_id") @db.Uuid
  usuarioId         String    @map("usuario_id") @db.Uuid
  // En pesos. Lo calcula el motor sumando los ítems; no llega de afuera.
  total             Decimal   @db.Decimal(12, 2)
  // La suma de los recargos de sus pagos. Es un CACHÉ, con el mismo criterio y
  // el mismo precedente que Articulo.stock respecto de sus movimientos: existe
  // para que el listado de /ventas no tenga que sumar los pagos de cada fila.
  // `total` NO cambia de significado: sigue siendo la mercadería a precio de
  // lista, así que ninguna venta ya cobrada queda diciendo otra cosa.
  recargo           Decimal   @default(0) @db.Decimal(12, 2)
  // La mercadería EN DÓLARES, a precio de lista. `total` es la mitad en pesos
  // de lo mismo, y no cambió de significado para ninguna fila anterior a este
  // ciclo: todas tienen `totalUsd = 0`.
  totalUsd          Decimal   @default(0) @map("total_usd") @db.Decimal(12, 2)
  /// Caché de la suma de los ítems que SÍ tenían costo. Mismo criterio que
  /// `recargo` frente a `Pago.recargo` y que `Articulo.stock` frente a sus
  /// movimientos: la fuente de verdad son los ítems, esto evita traerlos.
  costoArs          Decimal   @default(0) @map("costo_ars") @db.Decimal(12, 2)
  /// La mercadería EN PESOS de ESOS MISMOS ítems, a precio de lista.
  /// Existe para que el margen del período se divida contra la mercadería
  /// cuyo costo se conoce y no contra `total`, que incluye lo que no lo tiene:
  /// con `total` el porcentaje saldría subestimado sin que nada lo dijera.
  vendidoConCosto   Decimal   @default(0) @map("vendido_con_costo") @db.Decimal(12, 2)
  // La venta anulada NO se borra: sus ítems y su total quedan intactos porque
  // el historial tiene que poder responder qué se cobró, y cuando llegue ARCA
  // ésta va a ser el comprobante que necesita su nota de crédito.
  anuladaEn         DateTime? @map("anulada_en") @db.Timestamptz(3)
  anuladaPorId      String?   @map("anulada_por_id") @db.Uuid
  /// Texto libre que el local anota sobre la venta: a quién se le entregó, una
  /// dirección, un teléfono suelto. NO significa nada para el motor —no entra
  /// en ningún total ni en ninguna validación de plata—, y eso es justamente lo
  /// que hace segura la única escritura que existe sobre una venta ya cobrada
  /// (`guardarDetalle`, app/(app)/ventas/acciones.ts).
  ///
  /// Nullable y sin default, como `MovimientoStock.nota` y
  /// `UnidadDeArticulo.bajaNota`: `NULL` es "acá no se anotó nada". El saneo y
  /// el tope viven en `lib/ventas/detalle.ts`, compartidos por sus dos
  /// escritores.
  detalle           String?
  creadoEn          DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente    Cliente? @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  usuario    User     @relation("VentasHechas", fields: [usuarioId], references: [id], onDelete: Restrict)
  anuladaPor User?    @relation("VentasAnuladas", fields: [anuladaPorId], references: [id], onDelete: Restrict)

  items       VentaItem[]
  pagos       Pago[]
  movimientos MovimientoStock[]
  unidades    UnidadDeArticulo[]
  ediciones   EdicionDeVenta[]

  @@unique([tenantId, numero])
  @@unique([tenantId, claveIdempotencia])
  @@index([tenantId, creadoEn])
  // Las compras de un cliente, para su ficha (/clientes/[id]) y para el
  // conteo del listado. Sin él, cada ficha recorre las ventas del tenant.
  @@index([tenantId, clienteId])
  @@map("ventas")
}

// Precio y descripción CONGELADOS al momento de la venta. No son una referencia
// viva al artículo: los precios cambian todas las semanas y los artículos se
// renombran, y una venta de marzo tiene que seguir diciendo lo que se cobró en
// marzo. `articuloId` se guarda igual, para poder navegar, pero no es de donde
// sale lo que se muestra.
model VentaItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  ventaId        String   @map("venta_id") @db.Uuid
  articuloId     String   @map("articulo_id") @db.Uuid
  descripcion    String
  cantidad       Decimal  @db.Decimal(12, 3)
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(12, 2)
  // Congelada al vender, igual que `descripcion` y `precioUnitario`: el
  // artículo puede pasar de dólares a pesos mañana y esta venta tiene que
  // seguir diciendo en qué moneda se cobró.
  moneda         Moneda   @default(ARS)
  /// El último costo conocido del artículo AL MOMENTO DE COBRAR, en pesos.
  /// Congelado, igual que `descripcion` y `precioUnitario` y por el mismo
  /// motivo: un costo que se corrige mañana no puede cambiar lo que una venta
  /// de hoy dice que costó.
  /// NULL cuando el artículo no tenía ningún ingreso con costo cargado, NULL
  /// SIEMPRE para un ítem en dólares, y NULL para un ítem en pesos cuyo último
  /// costo se cargó en dólares (`MovimientoStock.monedaCosto`): esta columna
  /// es pesos y alimenta `Venta.costoArs`, y meter ahí un costo en dólares
  /// sería mentir. Tampoco se convierte con la cotización del local
  /// (`CotizacionDelDolar`, 2026-10-18): es el precio de hoy, no un dato que se
  /// pueda congelar; el congelado del costo en dólares es un ciclo pendiente.
  costoUnitario  Decimal? @map("costo_unitario") @db.Decimal(12, 2)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  articulo Articulo @relation(fields: [articuloId], references: [id], onDelete: Restrict)

  @@index([tenantId, ventaId])
  @@map("venta_items")
}

// Varios por venta: el pago partido —una parte en efectivo, otra por
// transferencia— es la norma, no la excepción.
model Pago {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  ventaId      String    @map("venta_id") @db.Uuid
  medio        MedioPago
  moneda       Moneda
  // Cuál de los dos totales de la venta paga esta fila. NO es lo mismo que
  // `moneda`, que es lo que la persona entrega: un pago en pesos puede cubrir
  // el total en dólares (se tipea la cotización y cuántos DÓLARES cubre), y
  // ahí `moneda = ARS` con `cubre = USD`. Ver la tabla de cuatro filas en
  // docs/superpowers/specs/2026-08-29-precio-en-usd-design.md.
  cubre        Moneda    @default(ARS)
  // En la moneda del pago, no en pesos.
  monto        Decimal   @db.Decimal(12, 2)
  // Los ARS que valía una unidad de esa moneda EN ESE MOMENTO. Un pago en pesos
  // lleva 1. Guardarla es lo que después deja cerrar la caja en las dos monedas
  // sin tener que reconstruir a qué valor se tomó cada dólar.
  cotizacion   Decimal   @db.Decimal(12, 4)
  // Con qué plan se cobró. NULL = a precio de lista, que es exactamente lo que
  // son todos los pagos que ya existen: esta columna no necesita backfill.
  planDePagoId String?   @map("plan_de_pago_id") @db.Uuid
  /// El porcentaje del plan con el que se cobró este pago, congelado igual que
  /// `recargo` y por el mismo motivo, un escalón más arriba: `recargo` dice
  /// cuántos pesos fueron recargo, y esto dice de dónde salieron.
  ///
  /// Hace falta desde que una venta ya cobrada puede CORREGIR sus pagos. Sin
  /// esta columna, corregir el medio de un pago obliga a releer
  /// `PlanDePago.recargoPorcentaje` —el de HOY— para todos los demás pagos de
  /// la venta, así que una venta de marzo cobrada al 40 % pasaría a decir que
  /// cobró el 45 % porque el dueño subió el plan en julio. Eso contradice de
  /// frente lo que el comentario de `recargo` promete: que un plan editado no
  /// puede cambiar lo que una venta vieja dice que cobró.
  ///
  /// Y no se puede derivar: `monto` es base más recargo, así que el porcentaje
  /// saldría de `recargo / (monto − recargo) × 100` — una DIVISIÓN, que es lo
  /// que este motor tiene prohibido (ver `aporteDePago` en totales.ts).
  ///
  /// Nullable y sin backfill: `NULL` es "se cobró antes de que esto existiera".
  /// Ahí la corrección cae al porcentaje de hoy, y el diálogo lo dice.
  porcentaje   Decimal?  @db.Decimal(6, 3)
  // Cuánto de este pago fue recargo — o descuento, en negativo. En PESOS
  // siempre, porque un pago en dólares no puede llevar plan (ver crear.ts).
  // CONGELADO, por lo mismo que VentaItem congela precio y descripción teniendo
  // articuloId: la venta de marzo tiene que seguir diciendo que se cobró 40 %
  // aunque el plan hoy esté en 45 % o esté dado de baja. La FK sirve para
  // navegar; este número es el que explica la plata.
  recargo      Decimal   @default(0) @db.Decimal(12, 2)
  creadoEn     DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venta  Venta       @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  // Restrict: un plan que ya cobró no se borra. Por eso el ABM da de baja.
  plan   PlanDePago? @relation(fields: [planDePagoId], references: [id], onDelete: Restrict)

  @@index([tenantId, ventaId])
  // Servía a `ultimaCotizacionUsd` — la última cotización en dólares del
  // local, que el punto de venta pedía en CADA carga de /vender —, borrada en
  // la Task 6 de este ciclo (2026-08-29): con precio de artículo en dólares,
  // ese default dejó de tener sentido. Queda SIN LECTOR y el índice NO se
  // borra: este ciclo es sólo aditivo, y el `DROP` de un índice es una
  // migración destructiva que corresponde a un deploy posterior.
  //
  // Sigue sin lector después del ciclo de la cotización del dólar
  // (2026-10-18): la cotización que el cobro precarga sale de
  // `CotizacionDelDolar`, con su propio índice, y NO del último pago — ése era
  // justamente el dato viejo que el 2026-08-29 sacó. Su `DROP` está anotado
  // junto con el de `Tenant.cotizacionUsd` en docs/contexto/proximos-pasos.md.
  @@index([tenantId, moneda, creadoEn])
  @@map("pagos")
}

/// Una corrección de cómo se pagó una venta: quién, cuándo y por qué.
///
/// Append-only, como `eventos_orden` y `movimientos_stock`, y no por
/// comentario: `scripts/setup-db-roles.sh` le revoca UPDATE y DELETE al rol de
/// la app. Una bitácora editable no contesta la única pregunta para la que
/// existe — "¿quién le cambió el medio de pago a esta venta y cuándo?".
model EdicionDeVenta {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ventaId   String   @map("venta_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  /// El motivo, si lo quisieron escribir. OPCIONAL a propósito: un motivo
  /// obligatorio sobre una corrección que suele ser evidente ("puse efectivo y
  /// era transferencia") es fricción, y un campo obligatorio que nadie quiere
  /// llenar se llena con un punto. Mismo criterio que `EventoOrden.nota`.
  nota      String?
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venta   Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  usuario User   @relation("VentasEditadas", fields: [usuarioId], references: [id], onDelete: Restrict)

  pagos PagoArchivado[]

  @@index([tenantId, ventaId, creadoEn])
  @@map("ediciones_venta")
}

/// Un pago tal como estaba ANTES de la corrección que lo reemplazó.
///
/// **El "después" no se guarda en ningún lado**: es `pagos` tal como está hoy,
/// o el "antes" de la edición siguiente. Guardar los dos lados sería un segundo
/// registro del mismo hecho, con el modo de falla que ya evitó que `VentaItem`
/// llevara `unidadId`: que un día digan cosas distintas.
///
/// **Se archiva la FILA y no un snapshot en JSON**: Prisma serializa un
/// `Decimal` a string, así que un JSON convertiría la plata en texto y perdería
/// la escala que `Decimal(12,2)` garantiza. Con tabla propia, un peso archivado
/// es el mismo tipo que un peso vivo.
model PagoArchivado {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  edicionId    String    @map("edicion_id") @db.Uuid
  medio        MedioPago
  moneda       Moneda
  cubre        Moneda
  monto        Decimal   @db.Decimal(12, 2)
  cotizacion   Decimal   @db.Decimal(12, 4)
  planDePagoId String?   @map("plan_de_pago_id") @db.Uuid
  porcentaje   Decimal?  @db.Decimal(6, 3)
  recargo      Decimal   @db.Decimal(12, 2)
  /// El `creadoEn` del pago original. Se llama distinto para que no se confunda
  /// con el de esta fila, que es cuándo se archivó.
  pagadoEn     DateTime  @map("pagado_en") @db.Timestamptz(3)
  creadoEn     DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  edicion EdicionDeVenta @relation(fields: [edicionId], references: [id], onDelete: Cascade)
  /// Restrict, igual que `Pago.planDePagoId`: un plan que ya cobró no se borra,
  /// se da de baja. La foto tiene que poder seguir diciendo cuál era.
  plan    PlanDePago?    @relation(fields: [planDePagoId], references: [id], onDelete: Restrict)

  @@index([tenantId, edicionId])
  @@map("pagos_archivados")
}

// La caja del turno: quién la abrió, con cuánto, quién la cerró y —desde el
// ciclo del arqueo (2026-10-18, spec 2026-10-18-arqueo-de-caja-design.md)— de
// cuánto fue el cierre y cuánto se retiró.
//
// El TURNO es una ventana de tiempo, `[abiertaEn, cerradaEn ?? ahora)`, y no
// una FK desde `Pago`: `crearVenta` no exige caja abierta, y la regla "una sola
// abierta por tenant" (índice único parcial) hace que la ventana identifique un
// solo turno. El efectivo ESPERADO se deriva de lo que el sistema ya sabe
// (lib/caja/efectivo.ts); lo único que se escribe a mano es lo que sólo una
// persona puede saber: lo que hay en el cajón cuando lo cuenta, y lo que se
// lleva. Los movimientos sin venta (ingresos, egresos, retiros) son
// `MovimientoDeCaja`.
model Caja {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  abiertaEn       DateTime @default(now()) @map("abierta_en") @db.Timestamptz(3)
  abiertaPorId    String   @map("abierta_por_id") @db.Uuid
  // Con cuánto efectivo arranca el turno. Decimal y nunca Float: un flotante
  // binario no representa 0,10 y el error se acumula en cada suma.
  saldoInicial    Decimal  @map("saldo_inicial") @db.Decimal(12, 2)
  // La misma apertura en dólares, que nunca se suma a la de pesos. Default 0 y
  // no nullable: toda caja que ya existía abrió sin dólares, que es
  // exactamente lo que dice un cero — no hace falta distinguir "no se sabe".
  saldoInicialUsd Decimal  @default(0) @map("saldo_inicial_usd") @db.Decimal(12, 2)

  // Nullable es lo que define "abierta": la caja del turno en curso es la que
  // tiene esto en NULL, y el índice único parcial de la migración usa
  // exactamente esa condición para que no haya dos.
  cerradaEn    DateTime? @map("cerrada_en") @db.Timestamptz(3)
  cerradaPorId String?   @map("cerrada_por_id") @db.Uuid

  // El arqueo del cierre, por moneda. TODAS nullable, y sin backfill: una caja
  // cerrada antes de este ciclo no tiene arqueo (y la imagen anterior, durante
  // el deploy, las ignora), y un llamador viejo de `cerrarCaja` —un formulario
  // cacheado— cierra sin ellas. NULL es "se cerró sin contar", no "contó cero".
  //
  // `esperado` es el que se RECALCULÓ en la transacción del cierre, no el que
  // mostraba la pantalla al abrir el formulario: si entró un cobro mientras la
  // persona contaba, el esperado guardado lo incluye.
  //
  // La diferencia (contado − esperado) y lo que queda (contado − retirado) se
  // derivan y no se guardan: guardarlas sería tener dos veces el mismo dato,
  // que se puede desincronizar. CHECKs de no-negativo en la migración (el
  // esperado sí puede ser negativo: un egreso mayor que lo que había es un
  // dato, no un error de escritura).
  esperadoArs Decimal? @map("esperado_ars") @db.Decimal(12, 2)
  esperadoUsd Decimal? @map("esperado_usd") @db.Decimal(12, 2)
  contadoArs  Decimal? @map("contado_ars") @db.Decimal(12, 2)
  contadoUsd  Decimal? @map("contado_usd") @db.Decimal(12, 2)
  retiradoArs Decimal? @map("retirado_ars") @db.Decimal(12, 2)
  retiradoUsd Decimal? @map("retirado_usd") @db.Decimal(12, 2)
  notaCierre  String?  @map("nota_cierre")

  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  abiertaPor  User               @relation("CajasAbiertas", fields: [abiertaPorId], references: [id], onDelete: Restrict)
  cerradaPor  User?              @relation("CajasCerradas", fields: [cerradaPorId], references: [id], onDelete: Restrict)
  movimientos MovimientoDeCaja[]

  @@index([tenantId, abiertaEn])
  @@map("cajas")
}

// Plata que entra o sale del cajón sin una venta: ingresos, egresos y retiros
// (spec 2026-10-18-arqueo-de-caja-design.md, decisión 2).
//
// Append-only: no se edita ni se borra. Un error se corrige con el movimiento
// contrario, y los dos quedan a la vista — un libro de caja editable no
// contesta "¿adónde fueron los $ 5.000?", y el que más motivo tendría para
// editarlo es justamente quien tiene que contestarlo. Lo sostiene el REVOKE de
// scripts/setup-db-roles.sh, no este comentario.
//
// FK a la caja y no una ventana de tiempo como los pagos: un movimiento sólo
// existe con una caja abierta (`registrarMovimiento` lo exige), así que la
// caja siempre se conoce y no hay nada que inferir. Restrict hacia la caja:
// con Cascade, borrar una caja sería la puerta de atrás del libro (el mismo
// agujero que eventos_orden cerró con un REVOKE sobre su padre); con Restrict,
// una caja con movimientos no se puede borrar, y ningún código borra cajas.
// Restrict hacia el usuario por lo mismo que `ediciones_venta`.
//
// `monto > 0` tiene CHECK en la migración: el sentido lo da el `tipo`, nunca el
// signo, para que no haya dos maneras de escribir un egreso.
model MovimientoDeCaja {
  id        String             @id @default(uuid(7)) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  cajaId    String             @map("caja_id") @db.Uuid
  tipo      TipoMovimientoCaja
  // Pesos y dólares nunca se suman: cada movimiento es de una sola moneda.
  moneda    Moneda
  monto     Decimal            @db.Decimal(12, 2)
  // Obligatoria para EGRESO —validado en lib/caja/movimientos.ts—: un egreso
  // sin motivo es el que nadie puede explicar después.
  nota      String?
  usuarioId String             @map("usuario_id") @db.Uuid
  creadoEn  DateTime           @default(now()) @map("creado_en") @db.Timestamptz(3)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caja    Caja   @relation(fields: [cajaId], references: [id], onDelete: Restrict)
  usuario User   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  // La única lectura: los movimientos de UNA caja, para el panel y para /caja.
  @@index([tenantId, cajaId])
  @@map("movimientos_de_caja")
}

model OrdenDeTrabajo {
  id                String  @id @default(uuid(7)) @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  // Sin huecos, por tenant: es el número que el cliente lee del ticket y dice
  // por teléfono. Mismo mecanismo que Venta.numero, y la decisión INVERSA a la
  // de proximoSkuArticulo, que sí tolera huecos porque un SKU no se recita.
  numero            Int
  // El doble click acá no cobra dos veces: imprime dos tickets con números
  // distintos para un solo equipo, y el cliente se lleva uno de los dos.
  claveIdempotencia String? @map("clave_idempotencia")

  // NO nullable, al revés que Venta.clienteId: una orden sin cliente no sirve,
  // porque el punto de todo esto es saber a quién llamar.
  clienteId     String      @map("cliente_id") @db.Uuid
  recibidaPorId String      @map("recibida_por_id") @db.Uuid
  estado        EstadoOrden @default(RECIBIDO)

  equipoMarca     String  @map("equipo_marca")
  equipoModelo    String  @map("equipo_modelo")
  // IMEI o número de serie. Opcional: hay equipos que entran sin encender.
  equipoSerie     String? @map("equipo_serie")
  // Texto plano y legible a propósito: el técnico tiene que USARLA para probar
  // que el arreglo funcionó, no compararla, así que hashearla no es una opción.
  // NO se imprime nunca, ni en la copia del local — lo asegura un test.
  claveDesbloqueo String? @map("clave_desbloqueo")

  // Lo que dijo el cliente. Obligatorio: es el motivo por el que el equipo
  // está acá, y va impreso en las dos copias.
  fallaDeclarada String  @map("falla_declarada")
  accesorios     String?
  danosVisibles  String? @map("danos_visibles")

  // Lo que encontró el técnico. Se carga después de recibir.
  diagnostico   String?
  // En pesos. Un número, no un documento: alcanza para decirle un precio al
  // cliente y para que el estado PRESUPUESTADO signifique algo.
  montoEstimado Decimal? @map("monto_estimado") @db.Decimal(12, 2)
  // Lo que le costó la reparación (repuestos), en pesos. null = nadie lo
  // cargó, que NO es lo mismo que cero: sin dato no se calcula ganancia en
  // vez de mostrar una ganancia inflada.
  costo         Decimal? @map("costo") @db.Decimal(12, 2)
  // Lo que efectivamente se cobró al entregar. Distinto de montoEstimado: el
  // presupuesto es lo prometido, esto es lo que entró.
  montoCobrado  Decimal? @map("monto_cobrado") @db.Decimal(12, 2)
  // La ÚLTIMA vez que la orden pasó a ENTREGADO; la escribe cambiarEstado. No
  // se borra al reabrir por garantía: la ganancia se atribuye al mes en que se
  // cobró, y el tablero filtra Entregado por mes.
  entregadaEn   DateTime? @map("entregada_en") @db.Timestamptz(3)

  // Anular es columna y no estado: como estado pisaría el estado anterior, y
  // se puede anular desde cualquier punto del ciclo. Misma forma que Venta.
  anuladaEn    DateTime? @map("anulada_en") @db.Timestamptz(3)
  anuladaPorId String?   @map("anulada_por_id") @db.Uuid

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict: borrar un cliente no puede borrar la historia de sus equipos.
  cliente     Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  recibidaPor User    @relation("OrdenesRecibidas", fields: [recibidaPorId], references: [id], onDelete: Restrict)
  anuladaPor  User?   @relation("OrdenesAnuladas", fields: [anuladaPorId], references: [id], onDelete: Restrict)

  eventos EventoOrden[]

  @@unique([tenantId, numero])
  @@unique([tenantId, claveIdempotencia])
  // El tablero filtra por estado y ordena por fecha: éste es su índice.
  @@index([tenantId, estado, creadoEn])
  @@index([tenantId, clienteId])
  @@index([tenantId, estado, entregadaEn])
  @@map("ordenes_de_trabajo")
}

// Append-only, como movimientos_stock: nada se edita ni se borra. Es lo que
// responde "hace dos semanas que está acá, ¿qué pasó?".
//
// Lo sostiene la BASE y no este comentario: scripts/setup-db-roles.sh le revoca
// UPDATE y DELETE a arandano_app sobre esta tabla, y DELETE sobre
// ordenes_de_trabajo, porque el `orden_id` de acá abajo es ON DELETE CASCADE y
// borrar la orden se llevaría la historia por la puerta de atrás.
model EventoOrden {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  ordenId  String @map("orden_id") @db.Uuid

  // Null en el evento de apertura, que no viene de ningún estado.
  desde EstadoOrden?
  hasta EstadoOrden
  nota  String?

  usuarioId String   @map("usuario_id") @db.Uuid
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orden   OrdenDeTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  usuario User           @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([tenantId, ordenId, creadoEn])
  @@map("eventos_orden")
}

// Las tres tablas que siguen son de Better Auth, y por eso sus campos llevan
// los nombres de la librería y no los del resto del schema: cada renombre sería
// una entrada en su `fields:` que puede desincronizarse en silencio. Los nombres
// de MODELO coinciden con los que Better Auth usa por defecto (`session`,
// `account`, `verification`), así que el adapter encuentra `prisma.session` sin
// una línea de configuración.

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // Único global y no por tenant: es un token aleatorio, no un dato del negocio.
  token     String   @unique
  expiresAt DateTime @map("expira_en") @db.Timestamptz(3)
  ipAddress String?  @map("ip")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("sessions")
}

// Donde vive el hash de la contraseña. Los campos de OAuth existen porque son
// parte del schema core de Better Auth, no porque se usen: este ciclo sólo
// habilita mail y contraseña.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expira_en") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expira_en") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("accounts")
}

// Tokens de verificación. Entra aunque en este ciclo no haya mail: es parte del
// schema core de la librería y su ausencia rompería operaciones internas.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expira_en") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, identifier])
  @@map("verifications")
}

// El bot de WhatsApp del local: la conexión con Kapso y su configuración, en
// UNA sola tabla y no en dos.
//
// Nacen juntas, son 1:1 con el tenant y ninguna sirve sin la otra: un bot
// configurado sin número conectado no contesta, y un número conectado sin
// configuración tampoco. Partirlas sería una FK para no ganar nada. El día que
// entre Instagram —CLAUDE.md promete "WhatsApp/Instagram"— esta tabla se parte
// en "la conexión de un canal" y "el bot", y ahí la FK va a significar algo.
//
// `phoneNumberId` es único GLOBAL y no por tenant: un número de WhatsApp no
// puede estar conectado a dos locales a la vez, y esa es exactamente la
// garantía que hace seguro el cruce del webhook (ver el docblock de la
// verificación de firma). Que el insert falle por unicidad le confirma a quien
// lo intente que el número ya está tomado, y es el precio correcto: la
// alternativa —dos locales creyendo que atienden el mismo número— manda las
// respuestas de uno a los clientes del otro.
model BotDeWhatsapp {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  // El customer de Kapso, con `external_customer_id` = nuestro tenant.id. Se
  // crea al pedir el primer enlace de conexión y sobrevive a una desconexión:
  // reconectar no tiene por qué crear un customer nuevo.
  kapsoCustomerId String?   @map("kapso_customer_id")
  // El identificador con el que Kapso y Meta nombran al número. Es la clave de
  // todo: se usa para enviar y para cruzar contra el payload del webhook.
  phoneNumberId   String?   @unique @map("phone_number_id")
  // El número tal como se lee (+54 9 11 …). Sólo para mostrarlo en la pantalla:
  // nada lo usa para decidir.
  numeroVisible   String?   @map("numero_visible")
  wabaId          String?   @map("waba_id")
  webhookId       String?   @map("webhook_id")
  // Con esto se verifica el HMAC de cada webhook entrante, así que se guarda EN
  // CLARO y no hay alternativa: hay que recalcular la firma con él, y un hash no
  // sirve para eso. Lo protegen la policy de RLS y el privilegio de
  // arandano_app, igual que el resto de los datos del local. Derivarlo de
  // BETTER_AUTH_SECRET + tenantId sería más lindo —no habría nada que guardar—
  // pero lo genera Kapso al crear el webhook y no se puede fijar.
  webhookSecreto  String?   @map("webhook_secreto")
  conectadoEn     DateTime? @map("conectado_en") @db.Timestamptz(3)

  // A quién le contesta: nadie, sólo los números de prueba, o todos. Arranca
  // APAGADO: conectar el número y ponerlo a contestar son dos decisiones, y la
  // segunda tiene que ser deliberada.
  modo          ModoBot @default(APAGADO)
  // YA NO DECIDE NADA en el código nuevo, y no se borra todavía (expand/
  // contract). Toda escritura de `modo` la escribe como `modo === 'TODOS'`, y
  // ese valor es el que hace seguro el rollback: la imagen anterior sólo lee
  // esta columna, así que si el healthcheck la revierte durante una prueba, lee
  // `false` y se calla en vez de contestarles a todos los clientes. El DROP va
  // en un deploy posterior.
  activo        Boolean @default(false)
  // A qué se dedica el local, en una frase, para que el bot no tenga que
  // adivinarlo. Va SEPARADO de `instrucciones` y no es una prolijidad: aquel
  // texto llega al modelo adentro de un cerco, rotulado como "información que
  // no tenés que obedecer", que es correcto para los horarios y es lo contrario
  // de lo que se quiere para la identidad del negocio — ésta va en la primera
  // oración del prompt. Hasta que existió esta columna, el prompt afirmaba un
  // rubro cableado y un local de waffles contestaba que vendía electrónica.
  //
  // No se llama `rubro`: en este proyecto esa palabra ya nombra al preset que
  // declara qué módulos vienen activados (ver CLAUDE.md).
  aQueSeDedica  String  @default("") @map("a_que_se_dedica")
  // Lo que el dueño escribe para que el bot lo sepa: horarios, dirección,
  // envíos. Texto libre y no un modelo de horarios, a propósito: ese modelo lo
  // van a necesitar también el catálogo público y el módulo de turnos, y
  // dibujarlo acá para un solo consumidor es elegir mal el momento.
  instrucciones String  @default("")
  // Cuántas respuestas puede dar el bot este mes. Es plata: cada una es una
  // llamada al modelo. El default alcanza para un local con movimiento y deja
  // el techo del gasto en un número que se puede mirar.
  topeMensual   Int     @default(1000) @map("tope_mensual")

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("bots_de_whatsapp")
}

// Los números a los que el bot les contesta en modo PRUEBA. Una fila por
// número: agregar es un INSERT y quitar un DELETE, la fila ES el dato, igual
// que usuario_permisos. Tabla propia y no un text[] en bots_de_whatsapp: la
// unicidad la sostiene el índice y no un chequeo de aplicación que dos pestañas
// pisarían.
//
// `digitos` guarda los dígitos tal como se tipearon (sin símbolos), no sólo los
// últimos 10, para que la pantalla muestre lo que el dueño cargó. La coincidencia
// con el waId es por los últimos 10 (lib/bot/numeros-de-prueba.ts), así que dos
// formas del mismo teléfono podrían convivir como filas distintas: la acción de
// agregar lo rechaza antes, y si pasara igual es inofensivo.
model NumeroDePruebaBot {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  digitos  String
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, digitos])
  @@map("numeros_de_prueba_bot")
}

// Un hilo con una persona. `waId` es su teléfono en formato internacional, tal
// como lo entrega Kapso — NO se normaliza contra `Cliente.telefono`, que el
// mostrador tipea a mano ("11 2233-4455") y que por lo tanto no matchea. Cruzar
// las dos cosas es el ciclo de servicio técnico por WhatsApp, no éste.
model ConversacionBot {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  waId                String   @map("wa_id")
  kapsoConversacionId String?  @map("kapso_conversacion_id")
  nombreContacto      String?  @map("nombre_contacto")
  creadoEn            DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  ultimoMensajeEn     DateTime @default(now()) @map("ultimo_mensaje_en") @db.Timestamptz(3)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mensajes MensajeBot[]

  @@unique([tenantId, waId])
  @@index([tenantId, ultimoMensajeEn])
  @@map("conversaciones_bot")
}

// Tabla-libro: lo que se dijo, append-only. Sostenida por REVOKE UPDATE, DELETE
// en scripts/setup-db-roles.sh —eso NO se hereda del default privilege, cada
// tabla-libro necesita su propia línea— igual que movimientos_stock y
// eventos_orden.
//
// `@@unique([tenantId, wamid])` es la idempotencia, y es el mismo mecanismo que
// Venta.claveIdempotencia por el mismo motivo: allá impide cobrar dos veces,
// acá impide contestar dos veces cuando Kapso reintenta el webhook (lo hace a
// los 10, 40 y 90 segundos si no recibe un 200). Que `wamid` sea nullable no lo
// debilita: en Postgres NULL ≠ NULL, así que varios salientes sin wamid
// conviven sin chocar, y el que importa —el entrante, que SIEMPRE trae wamid—
// choca cuando tiene que chocar.
model MensajeBot {
  id             String              @id @default(uuid(7)) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  conversacionId String              @map("conversacion_id") @db.Uuid
  direccion      DireccionMensaje
  texto          String
  wamid          String?
  // Sólo en los ENTRANTES: por qué éste no se contestó.
  motivo         MotivoSinRespuesta?
  // Sólo en los SALIENTES: por qué no se pudo entregar. Que esté cargado es lo
  // que hace que la fila NO cuente contra el tope mensual — una respuesta que
  // nunca llegó al cliente no gastó nada que valga la pena cobrarle al local.
  // Por eso el tope cuenta `direccion = SALIENTE AND error IS NULL` y no
  // salientes a secas.
  error          String?
  creadoEn       DateTime            @default(now()) @map("creado_en") @db.Timestamptz(3)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversacion ConversacionBot @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, wamid])
  // El índice del tope mensual: contar salientes del mes es la consulta que
  // corre en CADA mensaje entrante, antes de gastar un peso en el modelo.
  @@index([tenantId, direccion, creadoEn])
  // El del historial que se le pasa al agente.
  @@index([tenantId, conversacionId, creadoEn])
  @@map("mensajes_bot")
}

// La única tabla del schema SIN tenant_id, y la excepción está declarada en
// test/rls-cobertura.test.ts con su razón: un interesado que deja el mail en la
// landing no es cliente de nadie todavía. No hay tenant al que pertenezca, e
// inventarle uno sería peor que la excepción.
//
// Al no tener tenant_id no la protege la policy tenant_aislamiento, así que la
// protege el privilegio: scripts/setup-db-roles.sh le saca SELECT, UPDATE y
// DELETE a arandano_app. La aplicación sólo inserta; los leads se leen con
// `npm run leads`, que se conecta como owner.
//
// `rubro` es texto y no un enum: los rubros son ilimitados por diseño (son
// presets, no código), y un enum obligaría a una migración cada vez que alguien
// escriba "florería".
//
// `nombre`, `email` y `rubro` son nullable desde la Task 5 del cierre del
// rediseño (migración `lead_de_un_campo`): el formulario de la landing pasó
// de cinco campos a uno solo ("Tu WhatsApp o tu mail", design/arandano.pen).
// Ese único valor se clasifica y se guarda en `email` o en `whatsapp` según su
// forma —`app/sitio/acciones.ts`—, y `nombre`/`rubro`/`mensaje` quedan en
// NULL: ya no hay de dónde sacarlos. Los leads viejos (los cinco campos
// completos) conviven sin problema con los nuevos; lo único que cambió es
// que ya no se puede asumir que estas columnas vienen con datos —scripts/leads.mts
// las lee con esa guarda.
model Lead {
  id       String   @id @default(uuid(7)) @db.Uuid
  nombre   String?
  email    String?
  whatsapp String?
  rubro    String?
  mensaje  String?
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@map("leads")
}
