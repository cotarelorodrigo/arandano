# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (nunca commitear el .env real; .env.example es la plantilla)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/generated

# claude code: settings.json (compartido) SÍ se commitea, por eso .claude/
# no se ignora entero — sólo estas dos cosas, que nunca deberían.
# worktrees/ son los worktrees de git que arma el harness para trabajar
# aislado de la rama principal; no es código del repo.
.claude/worktrees/
# settings.local.json es config por máquina; el sufijo .local es la
# convención para lo que no se comparte.
.claude/settings.local.json

# superpowers: workspace de scratch del ciclo subagent-driven (ledger,
# briefs, reportes, paquetes de review). No es código del repo, y si no
# estuviera ignorado el paso 1 de deploy.sh rechazaría todo deploy por
# working tree sucio.
.superpowers/
